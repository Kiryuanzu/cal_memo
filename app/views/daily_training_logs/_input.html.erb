<%# locals: (daily_training_log:, selected_tab:, selected_date:, exercises_by_type:) %>

<section id="input-section" class="<%= panel_classes %>">
  <h2 class="<%= section_title_classes %>">筋トレ入力</h2>

  <p class="<%= section_description_classes %>">種目ボタンを押すと、表示中の日付に記録します。詳細は必要なときだけ入力できます。</p>

  <% if daily_training_log.errors.any? %>
    <div
      id="training-input-errors"
      class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900"
      role="alert"
    >
      <p class="font-semibold">入力内容を確認してください。</p>

      <ul class="mt-2 list-inside list-disc">
        <% daily_training_log.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if exercises_by_type.empty? %>
    <p class="<%= empty_state_classes %>">選択できる筋トレ種目がまだありません。</p>
  <% else %>
    <% TrainingExercise::TRAINING_TYPE_LABELS.each do |type, label| %>
      <% exercises = exercises_by_type.fetch(type, []) %>
      <% next if exercises.empty? %>

      <section id="training-<%= type %>" class="mt-6">
        <h3 class="text-lg font-bold text-stone-950"><%= label %></h3>

        <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          <% exercises.each do |exercise| %>
            <%= button_to exercise.name, daily_training_logs_path(tab: selected_tab, date: selected_date.iso8601),
                params: { daily_training_log: { training_exercise_id: exercise.id, trained_on: selected_date.iso8601 } },
                class: food_button_classes %>
          <% end %>
        </div>
      </section>
    <% end %>
    <%= tag.details class: "mt-6", open: daily_training_log.errors.any? do %>
      <summary class="cursor-pointer text-sm font-semibold text-stone-600 hover:text-stone-900">
        詳細を入力して記録（任意）
      </summary>

      <%= form_with model: daily_training_log, url: daily_training_logs_path(tab: selected_tab, date: selected_date.iso8601), class: "mt-6 grid gap-4 sm:grid-cols-2" do |form| %>
        <div>
          <%= form.label :trained_on, "日付（必須）", class: form_label_classes %>
          <%= form.date_field :trained_on, required: true, class: input_classes %>
        </div>

        <div>
          <%= form.label :training_exercise_id, "筋トレ種目（必須）", class: form_label_classes %>
          <%= form.select :training_exercise_id, grouped_options_for_select(training_exercise_options(exercises_by_type), daily_training_log.training_exercise_id), { prompt: "種目を選択" }, { required: true, class: input_classes } %>
        </div>

        <%= render "detail_fields", form: form %>

        <div class="sm:col-span-2">
          <%= form.submit "筋トレを記録", class: primary_button_classes %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>
